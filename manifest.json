{
  "manifest_version": 3,
  "name": "Kite Tax Lens",
  "version": "1.1.0",
  "description": "Tax intelligence overlay for Zerodha Kite Holdings — LT/ST badges, LTCG harvest wizard, SGB tracker.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "https://console.zerodha.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://kite.zerodha.com/*"],
      "js": ["content/kite-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kite.zerodha.com/*"],
      "js": ["lib/shared.js", "lib/tax.js", "content/kite.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://console.zerodha.com/portfolio/holdings*"],
      "js": ["lib/shared.js", "content/console.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kite Tax Lens"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
